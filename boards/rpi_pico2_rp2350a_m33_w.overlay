/* HamLab uses GPIO directly. See README for the full pin table. */
/ {
    hamlab_io: hamlab-io {
        compatible = "gpio-leds";
        dds-clock { gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>; };
    };
};

/* Identical Settings/NVS storage layout to pico-zephyr-transceiver-control/app.overlay. */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        storage_partition: partition@3f0000 {
            label = "storage";
            reg = <0x003f0000 0x00010000>;
        };
    };
};
